{
  "name": "crew-client",
  "version": "3.1.0",
  "description": "This is the Node.js SDK for the crew API, which allows you to easily integrate crew into your Node.js applications.",
  "keywords": [
    "AI",
    "API",
    "Crew",
    "Crew.AI",
    "LLM",
    "SDK"
  ],
  "homepage": "https://crew.ai",
  "bugs": {
    "url": "https://github.com/ezeslucky/crew/issues"
  },
  "license": "MIT",
  "author": "ezeslucky",
  "repository": {
    "type": "git",
    "url": "https://github.com/ezeslucky/crew.git",
    "directory": "sdks/nodejs-client"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist/index.d.ts",
    "dist/index.js"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vp pack",
    "type-check": "tsc",
    "test": "vp test",
    "test:coverage": "vp test --coverage",
    "publish:check": "./scripts/publish.sh --dry-run",
    "publish:npm": "./scripts/publish.sh"
  },
  "devDependencies": {
    "@crew/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
